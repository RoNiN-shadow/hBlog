cabal-version:   3.0
name:            blog
version:         0.1.0.0
license:         BSD-3-Clause
license-file:    LICENSE
maintainer:      marktishuk@gmail.com
author:          Mark
synopsis:        A custom blog generator from markup files
description:
    This package provides a static blog generator
    from a custom markup format to HTML.
    It defines a parser for this custom markup format
    as well as an html pretty printer EDSL.

category:        Text
build-type:      Simple
extra-doc-files: CHANGELOG.md

library
    exposed-modules:
        Blog
        Blog.Convert
        Blog.Html
        Blog.Html.Internal
        Blog.Markup
        Blog.Directory
        Blog.Env

    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base ^>=4.18.0.0,
        directory,
        filepath,
        mtl

executable blog
    main-is:          Main.hs
    hs-source-dirs:   app
    other-modules:    OptParse
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base ^>=4.18.0.0,
        optparse-applicative,
        directory,
        blog

test-suite blog-test
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    build-tool-depends: hspec-discover:hspec-discover
    hs-source-dirs:     test
    other-modules:
        MarkupParsingSpec
        SpecHook

    default-language:   Haskell2010
    ghc-options:        -O -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base ^>=4.18.0.0,
        blog,
        hspec,
        hspec-discover,
        raw-strings-qq
